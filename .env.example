# Sentinel backend configuration. Copy to .env; never commit real keys.

# Server / frontend CORS
HOST=127.0.0.1
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ── Embedding backend ──────────────────────────────────────────────
# Choose one: "gemini" | "local"
EMBEDDING_BACKEND=gemini

# Required when EMBEDDING_BACKEND=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Reasoning provider: demo | openai | gemini. Gemini receives only retrieved,
# redacted repository evidence; it never reads local files directly.
DEMO_MODE=true
LLM_PROVIDER=gemini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=30

# Use Person 2's vector retrieval for live project queries only when the
# matching embedding backend/model is configured. Otherwise lexical/symbol
# retrieval remains local and deterministic.
VECTOR_RETRIEVAL_ENABLED=false

# ── Chunking ───────────────────────────────────────────────────────
# Lines per chunk (CodeSplitter tree-sitter)
CHUNK_SIZE=40
CHUNK_OVERLAP=10

# ── Output ────────────────────────────────────────────────────────
OUTPUT_DIR=output
OUTPUT_FILE=chunks.json
